<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent del descargador de estados de asientos de NEO (solo lectura).
  Corre lunes a sábado a las 7:30, 12:30 y 17:30 (no domingo).
  Usa el Python del venv del repo (/Users/agentedepositojimenez/genesis-orion/.venv),
  que sí tiene dotenv/playwright. El python3 del sistema NO sirve.

  Instalación en la M1 (un solo comando):
    cp ~/genesis-orion/scripts/launchagents/com.sol.neo-asientos-estado.plist ~/Library/LaunchAgents/ \
      && launchctl unload ~/Library/LaunchAgents/com.sol.neo-asientos-estado.plist 2>/dev/null; \
       launchctl load ~/Library/LaunchAgents/com.sol.neo-asientos-estado.plist \
      && echo "LaunchAgent cargado"
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.sol.neo-asientos-estado</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/agentedepositojimenez/genesis-orion/.venv/bin/python</string>
    <string>/Users/agentedepositojimenez/genesis-orion/scripts/neo_asientos_estado_downloader.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/agentedepositojimenez/genesis-orion/scripts</string>

  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>30</integer></dict>
